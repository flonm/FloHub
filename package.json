{
  "name": "flohub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build.ts",
    "build:firefox": "bun build.ts firefox",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && eslint --max-warnings 0 .",
    "lint:fix": "oxlint --fix && eslint --fix .",
    "knip": "knip",
    "check": "bun run typecheck && bun run lint && bun run knip && bun run test",
    "lint:firefox": "bun run build:firefox && web-ext lint --self-hosted --source-dir dist-firefox",
    "sign:firefox": "bun run build:firefox && mkdir -p web-ext-artifacts && git archive --format zip --output web-ext-artifacts/source.zip HEAD && web-ext sign --source-dir dist-firefox --channel unlisted --upload-source-code web-ext-artifacts/source.zip",
    "e2e": "bun run build && bun e2e/smoke.ts",
    "storybook": "storybook dev -p 6008 --no-open",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/html-vite": "10.6.2",
    "@types/bun": "^1.4.3",
    "@types/chrome": "^0.3.5",
    "eslint": "^10.12.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-oxlint": "^1.88.0",
    "eslint-plugin-storybook": "^10.6.2",
    "eslint-plugin-unicorn": "^78.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "1.63.0",
    "storybook": "10.6.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "typescript-eslint-ts": "npm:typescript@6.0.3",
    "vite": "^8.3.4",
    "web-ext": "8"
  }
}
